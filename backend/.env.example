# Copy to `.env` and adjust. All variables use the FILAMIND_ prefix.
FILAMIND_HOST=0.0.0.0
FILAMIND_PORT=8000
FILAMIND_LOG_LEVEL=info
FILAMIND_MOONRAKER_URL=http://localhost:7125
# Comma-separated list of allowed browser origins (where the frontend is served).
FILAMIND_CORS_ORIGINS=http://localhost:5173
# Optional. A GitHub token makes the Setup widget's "latest version" lookups reliable: without one,
# GitHub allows only 60 requests/hour shared with Moonraker (often exhausted on a busy printer, so
# not-installed components show no version). A read-only / public fine-grained token is enough.
# FILAMIND_GITHUB_TOKEN=github_pat_xxx
