{
  "name": "filamind-flow-frontend",
  "version": "1.25.1",
  "private": true,
  "type": "module",
  "description": "Extensible Neo-Brutalist control panel for Klipper / Moonraker - frontend.",
  "license": "GPL-3.0-or-later",
  "author": "DeltaFabs team",
  "contributors": [
    "abdelmonem awad <eg2@live.com>",
    "Ahmed bebars <Ahmedbebars1@gmail.com>"
  ],
  "homepage": "https://github.com/filamind-app/filamind-flow#readme",
  "bugs": "https://github.com/filamind-app/filamind-flow/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filamind-app/filamind-flow.git",
    "directory": "frontend"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:keydiff": "node scripts/i18n-keydiff.mjs",
    "i18n:pseudo": "node scripts/i18n-pseudo.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@filamind-app/core": "^0.1.4",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "@fontsource/space-grotesk": "^5.2.10",
    "@tauri-apps/api": "^2.11.1",
    "html-to-image": "1.11.13",
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
