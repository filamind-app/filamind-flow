{
  "name": "filamind-flow-frontend",
  "version": "0.288.0",
  "private": true,
  "type": "module",
  "description": "Extensible Neo-Brutalist control panel for Klipper / Moonraker - frontend.",
  "license": "GPL-3.0-or-later",
  "author": "DeltaFabs team",
  "contributors": [
    "abdelmonem awad <eg2@live.com>",
    "Ahmed bebars <Ahmedbebars1@gmail.com>"
  ],
  "homepage": "https://github.com/filamind-app/filamind-flow#readme",
  "bugs": "https://github.com/filamind-app/filamind-flow/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filamind-app/filamind-flow.git",
    "directory": "frontend"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:keydiff": "node scripts/i18n-keydiff.mjs",
    "i18n:pseudo": "node scripts/i18n-pseudo.mjs"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.4"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
